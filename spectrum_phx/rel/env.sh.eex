#!/bin/sh
# Sourced by bin/<%= @release.name %> before every release command.
#
# The reason this file exists at all is Network=host.
#
# Spectrum runs in the host network namespace on a hypervisor, so anything the
# BEAM listens on is listening on the node's real interfaces -- including the
# storage network. The default RELEASE_DISTRIBUTION=sname starts EPMD on
# 0.0.0.0:4369 plus a distribution listener on a random ephemeral port, guarded
# only by the release cookie that is baked into the image. Nothing in this app
# needs distribution (DNSCluster is :ignore unless DNS_CLUSTER_QUERY is set), so
# it is off unless something asks for it.
#
# To get a remote shell for debugging, ask for it explicitly:
#
#   podman exec -e RELEASE_DISTRIBUTION=name -e RELEASE_NODE=debug@127.0.0.1 \
#     -it spectrum-phx /app/bin/<%= @release.name %> remote
#
# Note that `remote`/`rpc` can only attach to a running node when that node was
# itself started with distribution enabled.

if [ -z "${RELEASE_DISTRIBUTION}" ]; then
  if [ -n "${DNS_CLUSTER_QUERY}" ]; then
    RELEASE_DISTRIBUTION=name
  else
    RELEASE_DISTRIBUTION=none
  fi
  export RELEASE_DISTRIBUTION
fi

if [ "${RELEASE_DISTRIBUTION}" != "none" ]; then
  # Name the node after the address other nodes can actually reach it on. With
  # host networking that is the hypervisor IP, which the Quadlet passes as
  # PHX_HOST; fall back to loopback so a local `podman run` still works.
  if [ -z "${RELEASE_NODE}" ]; then
    RELEASE_NODE="<%= @release.name %>@${PHX_HOST:-127.0.0.1}"
    export RELEASE_NODE
  fi

  # Pin the distribution listener so a firewall rule can name a port instead of
  # the whole ephemeral range. Both ends of the range are the same port because
  # exactly one node runs per host.
  DIST_PORT="${RELEASE_DIST_PORT:-9199}"
  ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -kernel inet_dist_listen_min ${DIST_PORT} inet_dist_listen_max ${DIST_PORT}"
  export ELIXIR_ERL_OPTIONS
fi

# The release writes its pid/boot scratch files under RELEASE_TMP, which
# defaults to the release root. /app is owned by root and the container runs as
# an unprivileged user, so point it somewhere writable in both cases.
RELEASE_TMP="${RELEASE_TMP:-/tmp}"
export RELEASE_TMP
