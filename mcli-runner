                        import socket
                        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                        s.settimeout(0.2)
                        s.connect((ip, 2181))
                        s.sendall(b"stat")
                        resp = s.recv(1024).decode('utf-8', errors='ignore')
                        s.close()
                        if "mode: leader" in resp.lower() or "mode: standalone" in resp.lower():
                            zk_leader_ip = ip
                            break
                    except Exception:
                        pass
                        
                # 2. Check if ZK leader is active on port 8443 (Spectrum)
