            # Run ssh connection check by IP address
            res = subprocess.run(
                f"ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=yes {node_ip} exit",
                shell=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
            )
            
            if res.returncode != 0:
                err_msg = res.stderr.decode('utf-8', errors='ignore').strip() or f"exit code {res.returncode}"
                failed_hosts.append(f"{node_hostname} ({node_ip}) failed: {err_msg}")
            else:
                passed_hosts.append(f"{node_hostname} ({node_ip})")

        if failed_hosts:
            status = "FAIL"
            msg = "SSH inter-node trust verification FAILED:\n- " + "\n- ".join(failed_hosts)
        else:
            status = "PASS"
            msg = f"SSH inter-node trust fully verified for: {', '.join(passed_hosts)}."
    except Exception as ex:
        status = "FAIL"
        msg = f"Error executing SSH trust verification check: {str(ex)}"
    
    results["ssh_known_hosts_seeding"] = {
        "status": status,
        "output": msg
    }

    # 37. ZooKeeper Ensemble Scale & Observer Configuration Check
    # An even voting count buys no fault tolerance, and a node whose ZOO_SERVERS entry
    # disagrees with its own ZOO_PEER_TYPE votes (or abstains) against the ensemble's
    # intent -- both silently change where consensus can be reached.
    update_current_check(category, "zookeeper_ring_scale")
    try:
        hosts_cfg = get_cluster_hosts()
        node_count = len(hosts_cfg)
        node_ips = ", ".join(h.get("ip", "?") for h in hosts_cfg) or "none configured"

        if not os.path.exists(ZK_UNIT_FILE):
            status = "WARN"
            msg = (f"ZooKeeper unit {ZK_UNIT_FILE} does not exist on this node, so ensemble "
                   f"membership and observer configuration cannot be verified from here.")
        else:
            with open(ZK_UNIT_FILE, "r") as f:
                unit_text = f.read()

            my_id = None
            m_id = re.search(r"ZOO_MY_ID=(\d+)", unit_text)
            if m_id:
                my_id = int(m_id.group(1))

            # provision.py writes "ZOO_SERVERS=..." and cluster_new.py writes
            # ZOO_SERVERS="..."; matching the server.N entries directly handles both.
            entries = [(int(i), ip, bool(obs)) for i, ip, obs in
                       re.findall(r"server\.(\d+)=([^:\s\"]+):\d+:\d+(:observer)?;", unit_text)]
            voters = [(i, ip) for i, ip, obs in entries if not obs]
            observers = [(i, ip) for i, ip, obs in entries if obs]
            local_is_observer = "ZOO_PEER_TYPE=observer" in unit_text

            issues = []
            warns = []

            if not entries:
                # No server.N entries at all: the container runs standalone.
                if node_count <= 1:
                    status = "PASS"
                    msg = ("Single-node cluster: ZooKeeper runs standalone with no ensemble "
                           "membership, so there is no voting quorum to size. This is the correct "
                           "configuration for one node.")
                else:
                    status = "FAIL"
                    msg = (f"{node_count} nodes are configured in /etc/hci/cluster.json ({node_ips}) "
                           f"but this node's ZooKeeper unit declares no ensemble members: it is running "
                           f"standalone and is not participating in cluster consensus.")
            else:
                if node_count > 0 and len(entries) != node_count:
                    issues.append(
                        f"the ensemble declares {len(entries)} server(s) but /etc/hci/cluster.json "
                        f"defines {node_count} node(s) ({node_ips}); ZOO_SERVERS is out of sync with "
                        f"the cluster topology, so at least one node is missing from consensus")

                if my_id is not None:
                    mine = [(i, ip, obs) for i, ip, obs in entries if i == my_id]
                    if not mine:
                        issues.append(
                            f"this node advertises ZOO_MY_ID={my_id} but the ensemble has no "
                            f"server.{my_id} entry, so it cannot join the quorum it is configured for")
                    else:
                        _, my_ip, my_obs = mine[0]
                        if my_obs != local_is_observer:
                            issues.append(
                                f"node {my_ip} (server.{my_id}) is declared "
                                f"{'an observer' if my_obs else 'a voting member'} in ZOO_SERVERS but "
                                f"its ZOO_PEER_TYPE says "
                                f"{'observer' if local_is_observer else 'participant'}; the ensemble "
                                f"and the node disagree about whether it votes")

                voter_count = len(voters)
                if voter_count and voter_count % 2 == 0:
                    tolerated = voter_count - (voter_count // 2 + 1)
                    warns.append(
                        f"the ensemble has {voter_count} voting members "
                        f"({', '.join(ip for _, ip in voters)}): quorum is {voter_count // 2 + 1}, so it "
                        f"tolerates {tolerated} failure(s) -- exactly what {voter_count - 1} voters "
                        f"would tolerate. The extra voter adds cost and no availability; use an odd "
                        f"number of voting members")

                if voter_count > 7:
                    warns.append(
                        f"{voter_count} voting members is beyond the practical Zab write-quorum size; "
                        f"keep 3 (or at most 5) voters and configure the remaining nodes as observers")

                if node_count > 3 and voter_count != 3:
                    warns.append(
                        f"this {node_count}-node cluster has {voter_count} voting member(s) and "
                        f"{len(observers)} observer(s); nodes beyond the third are expected to be "
                        f"observers (3 voters), otherwise every write waits on a larger quorum")

                if issues:
                    status = "FAIL"
                    msg = "ZooKeeper ensemble configuration is unsafe:\n- " + "\n- ".join(issues)
                    if warns:
                        msg += "\nAdditional warnings:\n- " + "\n- ".join(warns)
                elif warns:
                    status = "WARN"
                    msg = "ZooKeeper ensemble scale warnings:\n- " + "\n- ".join(warns)
                else:
                    status = "PASS"
                    msg = (f"ZooKeeper ensemble is correctly scaled: {len(voters)} voting member(s) "
                           f"({', '.join(ip for _, ip in voters)})"
                           + (f" and {len(observers)} observer(s) "
                              f"({', '.join(ip for _, ip in observers)})" if observers else "")
                           + f", quorum {len(voters) // 2 + 1}, across {node_count} configured node(s).")
    except Exception as e:
        status = "WARN"
        msg = f"Error running ZooKeeper ensemble scale check: {str(e)}"
    results["zookeeper_ring_scale"] = {
        "status": status,
        "output": msg
    }

    # 38. ScyllaDB Quorum Safety Check
    # Answers one question an operator asks before every maintenance window: if this node
    # goes down, does the database keep serving quorum operations?
    update_current_check(category, "scylladb_quorum_safety")
    try:
        hosts_cfg = get_cluster_hosts()
        node_count = len(hosts_cfg)
        rf, rf_detail = get_hydra_replication_factor()
        maint = in_maintenance()

        if rf is None:
            status = "WARN"
            msg = ("Could not read the replication factor of keyspace 'hydra', so quorum safety "
                   f"cannot be evaluated: {rf_detail}")
        elif node_count <= 1:
            status = "PASS"
            msg = (f"Single-node cluster with RF={rf}: quorum is this node alone, so there is no "
                   "quorum redundancy to lose. Stopping the only node stops the database, which is "
                   "expected on a one-node cluster rather than a fault.")
        else:
            live, down, total, ring_raw = get_scylla_ring()
            if live is None:
                status = "WARN"
                msg = ("Could not read the ScyllaDB ring, so quorum safety cannot be evaluated: "
                       f"{ring_raw}")
            else:
                quorum = rf // 2 + 1
                node_ips = ", ".join(h.get("ip", "?") for h in hosts_cfg)
                if live < quorum:
                    # In a maintenance window this is the expected cost of the window, not news.
                    status = "WARN" if maint else "FAIL"
                    msg = (f"ScyllaDB cannot form a quorum: {live} of {total} ring node(s) are live "
                           f"(UN) but RF={rf} requires {quorum} replica(s) for QUORUM. Quorum reads "
                           f"and writes against keyspace 'hydra' are failing right now"
                           + (" (this host is in maintenance mode, so it is expected for the duration "
                              "of the window)." if maint else ".")
                           + f"\nConfigured nodes: {node_ips}\n{ring_raw}")
                elif live - 1 < quorum:
                    status = "WARN"
                    msg = (f"ScyllaDB has no quorum headroom: {live} live node(s) at RF={rf} where "
                           f"QUORUM needs {quorum}. Taking any single node into maintenance leaves "
                           f"{live - 1} live node(s) and freezes quorum operations on keyspace "
                           f"'hydra' until it returns. Daruk degrades reads to consistency level ONE, "
                           f"but quorum writes will fail.\nConfigured nodes: {node_ips}\n{ring_raw}")
                else:
                    status = "PASS"
                    msg = (f"ScyllaDB quorum is safe: {live} of {total} node(s) live at RF={rf} "
                           f"(QUORUM needs {quorum}); {live - quorum} node(s) can enter maintenance "
                           f"before quorum is lost.")
    except Exception as e:
        status = "WARN"
        msg = f"Error running ScyllaDB quorum safety check: {str(e)}"
    results["scylladb_quorum_safety"] = {
        "status": status,
        "output": msg
    }

    # 39. Replication Factor vs Repair Check
    # ALTER KEYSPACE is instant and system_schema reports the new factor immediately, but
    # existing data is not copied to the new replicas until a repair runs. Until then the
    # cluster reports fault tolerance it does not have.
    update_current_check(category, "replication_factor_vs_repair")
    try:
        cfg = get_cluster_config()
        hosts_cfg = [h for h in cfg.get("hosts", []) if h.get("ip")]
        node_count = len(hosts_cfg)
        try:
            ftt = int(cfg.get("redundancy_factor", 1))
        except (TypeError, ValueError):
            ftt = 1
        rf, rf_detail = get_hydra_replication_factor()
        # Same derivation spectrum_server.py uses: one replica per tolerated failure plus
        # the original, capped by the number of nodes that can actually hold one.
        expected_rf = min(node_count, ftt + 1) if node_count > 1 else 1

        if rf is None:
            status = "WARN"
            msg = f"Could not read the replication factor of keyspace 'hydra': {rf_detail}"
        elif node_count <= 1:
            if rf <= 1:
                status = "PASS"
                msg = (f"Single-node cluster (redundancy_factor={ftt}): keyspace 'hydra' is RF={rf}, "
                       "the only correct value for one node. Repair is not applicable here -- there "
                       "is no second replica to stream to.")
            else:
                status = "WARN"
                msg = (f"Keyspace 'hydra' is RF={rf} but this cluster has a single node. Scylla "
                       f"accepts the ALTER, yet {rf - 1} replica(s) can never be placed, so the "
                       f"keyspace reports fault tolerance that does not exist. Set RF=1 or add nodes.")
        else:
            findings = []
            critical = False

            if rf == 1 and expected_rf > 1:
                critical = True
                findings.append(
                    f"keyspace 'hydra' is RF=1 on a {node_count}-node cluster configured for "
                    f"redundancy_factor={ftt} (expected RF={expected_rf}). Every partition lives on "
                    f"exactly one node, so losing any node loses the cluster metadata it owned: the "
                    f"cluster is reporting fault tolerance it does not have")
            elif rf == 1:
                findings.append(
                    f"keyspace 'hydra' is RF=1 across {node_count} nodes. redundancy_factor={ftt} "
                    f"means this is deliberate, but the database has no fault tolerance: losing any "
                    f"node loses the metadata it owned")

            if rf > node_count:
                findings.append(
                    f"keyspace 'hydra' is RF={rf} but only {node_count} node(s) are configured "
                    f"({', '.join(h.get('ip', '?') for h in hosts_cfg)}), so {rf - node_count} "
                    f"replica(s) can never be placed")
            elif rf < expected_rf:
                findings.append(
                    f"keyspace 'hydra' is RF={rf} but redundancy_factor={ftt} over {node_count} "
                    f"nodes calls for RF={expected_rf}")

            # Repair evidence. With RF >= node count every live node must hold a full copy of
            # the keyspace, so a node carrying a fraction of what its peers carry is what an
            # RF increase without a subsequent repair looks like from the outside.
            repair_note = ""
            live, down, total, ring_raw = get_scylla_ring()
            loads = parse_nodetool_load(ring_raw) if live else {}
            if rf > 1 and rf >= node_count and len(loads) > 1:
                max_ip = max(loads, key=lambda k: loads[k])
                min_ip = min(loads, key=lambda k: loads[k])
                max_load, min_load = loads[max_ip], loads[min_ip]
                # Under ~64 MiB the load is dominated by system tables and commitlog noise,
                # where the ratio between nodes carries no signal.
                if max_load > 64 * 1024 ** 2 and min_load < max_load * 0.5:
                    findings.append(
                        f"node {min_ip} holds {min_load / 1024 ** 3:.2f} GiB while {max_ip} holds "
                        f"{max_load / 1024 ** 3:.2f} GiB, yet RF={rf} over {node_count} node(s) means "
                        f"every node should hold a full copy. This is what raising RF without a "
                        f"subsequent repair looks like; run 'podman exec systemd-hydra-db nodetool "
                        f"repair -pr hydra' on each node")
                else:
                    repair_note = (f"\nReplica loads are even across the ring "
                                   f"({min_load / 1024 ** 2:.0f} MiB on {min_ip} to "
                                   f"{max_load / 1024 ** 2:.0f} MiB on {max_ip}), which is consistent "
                                   f"with a repaired keyspace.")
            elif rf > 1:
                repair_note = ("\nNote: replica population could not be compared on this topology, so "
                               "a repair following an RF increase cannot be confirmed from here.")

            if critical:
                status = "FAIL"
            elif findings:
                status = "WARN"
            else:
                status = "PASS"

            if findings:
                msg = "Replication factor audit:\n- " + "\n- ".join(findings) + repair_note
            else:
                msg = (f"Keyspace 'hydra' is RF={rf} across {node_count} node(s) with "
                       f"redundancy_factor={ftt} (expected RF={expected_rf})." + repair_note)
    except Exception as e:
        status = "WARN"
        msg = f"Error running replication factor vs repair check: {str(e)}"
    results["replication_factor_vs_repair"] = {
        "status": status,
        "output": msg
    }

    # 40. mTLS Certificate Expiry Warning
    # Nothing in the stack renews these. Every mTLS call between nodes stops working the
    # day they lapse, so the window has to be wide enough for a human to act on.
    update_current_check(category, "mtls_cert_expiry_warning")
    try:
        expired, critical_certs, expiring, healthy, unverified = [], [], [], [], []
        now = time.time()

        for cert_dir in MTLS_CERT_DIRS:
            if not os.path.isdir(cert_dir):
                unverified.append(f"certificate directory {cert_dir} does not exist on this node")
                continue
            try:
                names = sorted(n for n in os.listdir(cert_dir)
                               if n.endswith(".crt") or n.endswith(".pem"))
            except Exception as ex:
                unverified.append(f"cannot list {cert_dir}: {str(ex)}")
                continue
            if not names:
                unverified.append(f"no certificates (*.crt / *.pem) found in {cert_dir}")
                continue

            for name in names:
                path = os.path.join(cert_dir, name)
                epoch, detail = cert_expiry_epoch(path)
                if epoch is None:
                    unverified.append(f"{path}: {detail}")
                    continue
                days = (epoch - now) / 86400.0
                if days < 0:
                    expired.append(f"{path} EXPIRED {abs(days):.1f} days ago (notAfter={detail})")
                elif days < CERT_FAIL_DAYS:
                    critical_certs.append(
                        f"{path} expires in {days:.1f} days (notAfter={detail})")
                elif days < CERT_WARN_DAYS:
                    expiring.append(f"{path} expires in {days:.1f} days (notAfter={detail})")
                else:
                    healthy.append(f"{path} valid for {days:.0f} more days")

        renewal_hint = ("\nThere is no renewal daemon: these certificates are reissued by hand, so "
                        "they must be replaced before the date above.")
        if expired or critical_certs:
            status = "FAIL"
            msg = ("mTLS certificate expiry is critical:\n- "
                   + "\n- ".join(expired + critical_certs) + renewal_hint)
            if expiring or unverified:
                msg += "\nAlso noted:\n- " + "\n- ".join(expiring + unverified)
        elif expiring:
            status = "WARN"
            msg = (f"mTLS certificate(s) expiring within {CERT_WARN_DAYS} days:\n- "
                   + "\n- ".join(expiring) + renewal_hint)
            if unverified:
                msg += "\nAlso noted:\n- " + "\n- ".join(unverified)
        elif unverified:
            status = "WARN"
            msg = ("Some mTLS certificates could not be checked for expiry:\n- "
                   + "\n- ".join(unverified))
            if healthy:
                msg += "\nVerified as valid:\n- " + "\n- ".join(healthy)
        elif healthy:
            status = "PASS"
            msg = (f"All {len(healthy)} certificate(s) under {', '.join(MTLS_CERT_DIRS)} are valid "
                   f"for more than {CERT_WARN_DAYS} days:\n- " + "\n- ".join(healthy))
        else:
            status = "WARN"
            msg = (f"No certificates were found to check under {', '.join(MTLS_CERT_DIRS)}, so mTLS "
                   f"certificate expiry could not be verified on this node.")
    except Exception as e:
        status = "WARN"
        msg = f"Error running mTLS certificate expiry check: {str(e)}"
    results["mtls_cert_expiry_warning"] = {
        "status": status,
        "output": msg
    }

    # 41. Flapping Service Check
    # `systemctl is-active` returns "active" during each restart window of a unit with
    # Restart=always, so a unit failing in a loop samples as healthy roughly half the time.
    # NRestarts counts only automatic restarts, which makes the flapping visible.
    update_current_check(category, "flapping_service_check")
    try:
        managed = ["zookeeper", "hydra-db", "daruk", "aether", "linstor-controller",
                   "spark-daemon", "spectrum", "slate", "agahnim", "catalyst", "vali",
                   "bifrost", "dagur", "mimir", "logos", "mipha", "gatoway", "hylia",
                   "libvirtd"]
        if urbosa_active:
            managed.append("urbosa")

        maint = in_maintenance()
        crash_looping, flapping, absent, quiet = [], [], [], []

        for svc in managed:
            rc_f, out_f, err_f = run_cmd(
                "systemctl show -p LoadState -p ActiveState -p SubState -p NRestarts "
                "-p MainPID -p Result " + svc)
            if rc_f != 0 and not out_f:
                absent.append(f"{svc}: could not read restart counters ({err_f or 'no output'})")
                continue

            props = {}
            for line in out_f.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    props[k.strip()] = v.strip()

            if props.get("LoadState") == "not-found":
                # Not every node runs every unit; a unit that was never installed is not a fault.
                continue

            try:
                n_restarts = int(props.get("NRestarts", "0") or 0)
            except ValueError:
                n_restarts = 0
            active_state = props.get("ActiveState", "unknown")
            sub_state = props.get("SubState", "unknown")
            main_pid = props.get("MainPID", "0")
            result = props.get("Result", "success")

            detail = (f"{svc}: {n_restarts} automatic restart(s) "
                      f"(ActiveState={active_state}, SubState={sub_state}, "
                      f"MainPID={main_pid}, Result={result})")

            # The exact shape of the hylia incident: systemd reports the unit active while
            # it has no main process, because the sample landed inside a restart window.
            mid_respawn = (active_state in ("active", "activating") and main_pid in ("0", "")
                           and n_restarts >= FLAP_WARN_RESTARTS and not maint)

            if n_restarts >= FLAP_FAIL_RESTARTS or mid_respawn:
                crash_looping.append(
                    detail + (" - reported active with no main process, i.e. sampled inside a "
                              "restart window" if mid_respawn else " - crash-looping"))
            elif n_restarts >= FLAP_WARN_RESTARTS:
                flapping.append(detail)
            elif n_restarts > 0:
                quiet.append(f"{svc}: {n_restarts} restart(s)")

        if crash_looping:
            status = "FAIL"
            msg = ("Service(s) are crash-looping; a status of 'active' from systemctl is not "
                   "evidence they are running:\n- " + "\n- ".join(crash_looping))
            if flapping:
                msg += "\nAlso restarting repeatedly:\n- " + "\n- ".join(flapping)
        elif flapping:
            status = "WARN"
            msg = (f"Service(s) have auto-restarted at least {FLAP_WARN_RESTARTS} times:\n- "
                   + "\n- ".join(flapping))
        elif absent:
            status = "WARN"
            msg = "Restart counters could not be read for some units:\n- " + "\n- ".join(absent)
        else:
            status = "PASS"
            msg = (f"No managed service is flapping: all {len(managed)} unit(s) are below "
                   f"{FLAP_WARN_RESTARTS} automatic restarts.")
            if quiet:
                msg += "\nUnits with a small restart history:\n- " + "\n- ".join(quiet)
    except Exception as e:
        status = "WARN"
        msg = f"Error running flapping service check: {str(e)}"
    results["flapping_service_check"] = {
        "status": status,
        "output": msg
    }

    # 42. Stale Node Registration Check
    # Each node holds an ephemeral znode under /helios/nodes refreshed every 5s. A node
    # configured in cluster.json whose znode is missing or stale is not publishing state,
    # so anything reading that tree (cluster status, the reconcile loop) is working from a
    # cluster view that no longer includes it.
    update_current_check(category, "stale_node_registration")
    client = None
    try:
        zkmod = load_helios_zk()
        hosts_cfg = get_cluster_hosts()
        configured = [h.get("ip") for h in hosts_cfg if h.get("ip")]
        hostname_by_ip = {h.get("ip"): h.get("hostname", "") for h in hosts_cfg}

        if zkmod is None:
            status = "WARN"
            msg = ("The helios_zk client is not deployed on this node "
                   "(/usr/local/bin/helios_zk.py), so node registrations in ZooKeeper cannot be "
                   "verified from here.")
        elif not configured:
            status = "WARN"
            msg = ("No hosts are configured in /etc/hci/cluster.json, so there is no expected node "
                   "set to compare the ZooKeeper registrations against.")
        else:
            zk_hosts = ["127.0.0.1"] + [ip for ip in configured if ip != "127.0.0.1"]
            client = zkmod.connect(zk_hosts, timeout=3.0)
            registered = {}
            try:
                for name in client.get_children(ZK_NODES_PATH):
                    try:
                        registered[name] = json.loads(
                            client.get(ZK_NODES_PATH + "/" + name).decode("utf-8"))
                    except Exception:
                        registered[name] = {}
            except Exception:
                # The tree not existing yet is a real answer: nothing has registered.
                registered = {}

            now = int(time.time())
            missing, stale, unexpected, fresh = [], [], [], []

            for ip in configured:
                label = f"{hostname_by_ip.get(ip) or 'node'} ({ip})"
                if ip not in registered:
                    missing.append(
                        f"{label} is configured in cluster.json but has no ephemeral znode under "
                        f"{ZK_NODES_PATH}; its session is gone or spark-daemon is not publishing")
                    continue
                data = registered[ip] or {}
                try:
                    ts = int(data.get("ts", 0) or 0)
                except (TypeError, ValueError):
                    ts = 0
                age = now - ts
                if ts <= 0:
                    stale.append(f"{label} has a znode carrying no publish timestamp")
                elif age > NODE_STALE_AFTER:
                    stale.append(
                        f"{label} last published {age}s ago (stale beyond {NODE_STALE_AFTER}s); "
                        f"maintenance_status={data.get('maintenance_status', 'unknown')}")
                else:
                    fresh.append(f"{label} published {age}s ago")

            for name in registered:
                if name not in configured:
                    unexpected.append(
                        f"{name} holds a znode under {ZK_NODES_PATH} but is not configured in "
                        f"/etc/hci/cluster.json")

            maint = in_maintenance()
            if missing:
                # During a maintenance window nodes are expected to come and go.
                status = "WARN" if maint else "FAIL"
                msg = "Node registration in ZooKeeper is incomplete:\n- " + "\n- ".join(missing)
                if maint:
                    msg += ("\nThis host is in maintenance mode, so registrations are expected to "
                            "churn for the duration of the window.")
                if stale or unexpected:
                    msg += "\nAlso noted:\n- " + "\n- ".join(stale + unexpected)
            elif stale or unexpected:
                status = "WARN"
                msg = "Node registration warnings:\n- " + "\n- ".join(stale + unexpected)
            else:
                status = "PASS"
                msg = (f"All {len(configured)} configured node(s) hold a fresh ephemeral znode under "
                       f"{ZK_NODES_PATH} (within {NODE_STALE_AFTER}s):\n- " + "\n- ".join(fresh))
    except Exception as e:
        status = "WARN"
        msg = (f"Could not verify node registrations in ZooKeeper: {str(e)}. The ZooKeeper service "
               f"checks own the verdict on ZooKeeper itself.")
    finally:
        if client is not None:
            try:
                client.close()
            except Exception:
                pass
    results["stale_node_registration"] = {
        "status": status,
        "output": msg
    }

    return results

def check_storage(category):
    results = {}
    
    controller_ip = "127.0.0.1"
    try:
        import json
        if os.path.exists("/etc/hci/cluster.json"):
            with open("/etc/hci/cluster.json", "r") as f:
                cdata = json.load(f)
                hosts = cdata.get("hosts", [])
                if hosts:
                    controller_ip = ",".join([h["ip"] for h in hosts])
    except Exception:
        pass
        
    # 1. Aether peer status (Aether Nodes)
    update_current_check(category, "aether_peers")
    rc, out, err = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ip} systemd-aether linstor node list")
    if rc == 0:
        offline = "OFFLINE" in out.upper() or "ERROR" in out.upper()
        status = "FAIL" if offline else "PASS"
        msg = out
    else:
        status = "FAIL"
        msg = f"Failed to query Aether node list: {err or out}"
    results["aether_peers"] = {
        "status": status,
        "output": msg
    }
    
    # 2. Aether volume status (Aether Resources)
    update_current_check(category, "aether_volume")
    rc, out, err = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ip} systemd-aether linstor resource list")
    if rc == 0:
        failed = "ERROR" in out.upper() or "FATAL" in out.upper() or "DEVIATING" in out.upper()
        db_in_use = False
        for line in out.splitlines():
            if "linstor-db" in line and "InUse" in line:
                db_in_use = True
        if failed:
            status = "FAIL"
            msg = out
        elif not db_in_use:
            status = "FAIL"
            msg = f"CRITICAL: The database volume (linstor-db) is NOT active (InUse) on any node.\n\nLinstor Resource List:\n{out}"
        else:
            status = "PASS"
            msg = out
    else:
        status = "FAIL"
        msg = f"Failed to query Aether resource list: {err or out}"
    results["aether_volume"] = {
        "status": status,
        "output": msg
    }
    
    # 3. Disk storage pool mount check (Aether Storage Pools)
    update_current_check(category, "aether_storage_pools")
    rc, out, err = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ip} systemd-aether linstor storage-pool list")
    if rc == 0:
        ok = "default-pool" in out and "Ok" in out
        status = "PASS" if ok else "FAIL"
        msg = out
    else:
        status = "FAIL"
        msg = f"Failed to query Aether storage pool: {err or out}"
    results["aether_storage_pools"] = {
        "status": status,
        "output": msg
    }

    # 4. Storage volume capacity check
    update_current_check(category, "storage_capacity")
    volumes_cap = [
        ("default-vm-container", "/var/lib/hci/aether/volumes/default-vm-container"),
        ("default-image-container", "/var/lib/hci/aether/volumes/default-image-container")
    ]
    statuses_cap = []
    messages_cap = []
    for name, vol_path in volumes_cap:
        if os.path.exists(vol_path):
            try:
                stat = os.statvfs(vol_path)
                total = stat.f_blocks * stat.f_frsize
                free = stat.f_bavail * stat.f_frsize
                used = total - free
                pct = (used / total) * 100 if total > 0 else 0
                
                vol_status = "PASS"
                if pct > 90.0:
                    vol_status = "FAIL"
                elif pct > 80.0:
                    vol_status = "WARN"
                
                statuses_cap.append(vol_status)
                messages_cap.append(f"Volume: {name}\nPath: {vol_path}\nTotal Space: {total // 1024**3} GB\nUsed Space: {used // 1024**3} GB ({pct:.1f}% used)\nFree Space: {free // 1024**3} GB")
            except Exception as e:
                statuses_cap.append("FAIL")
                messages_cap.append(f"{name}: Failed to check storage path statistics: {str(e)}")
        else:
            statuses_cap.append("PASS")
            messages_cap.append(f"{name}: standby / not mounted locally on this host (Aether).")
                
    status = "FAIL" if "FAIL" in statuses_cap else ("WARN" if "WARN" in statuses_cap else "PASS")
    msg = "\n\n".join(messages_cap)
    results["storage_capacity"] = {
        "status": status,
        "output": msg
    }
    
    # 5. Aether Split Brain Check
    update_current_check(category, "aether_split_brain")
    rc, out, err = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ip} systemd-aether linstor resource list")
    if rc == 0:
        sb = "SplitBrain" in out or "Inconsistent" in out
        status = "FAIL" if sb else "PASS"
        msg = "No Aether split-brain detected." if not sb else f"WARNING: Aether Split-brain detected!\n{out}"
    else:
        status = "FAIL"
        msg = f"Failed to query Aether status: {err or out}"
    results["aether_split_brain"] = {
        "status": status,
        "output": msg
    }
    
    # 6. Aether Heal Pending Check
    update_current_check(category, "aether_heal_pending")
    rc, out, err = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ip} systemd-aether linstor volume list")
    if rc == 0:
        syncing = "Syncing" in out or "PausedSync" in out
        status = "WARN" if syncing else "PASS"
        msg = "No Aether volume synchronization active (healthy)." if not syncing else f"Aether volume(s) are syncing:\n{out}"
    else:
        status = "FAIL"
        msg = f"Failed to query Aether volume status: {err or out}"
    results["aether_heal_pending"] = {
        "status": status,
        "output": msg
    }
    
    # 7. Storage Pool Space Utilization Check
    update_current_check(category, "aether_storage_pools_space")
    rc, out, err = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ip} systemd-aether linstor storage-pool list")
    if rc == 0:
        status = "PASS"
        if "Ok" not in out:
            status = "WARN"
        msg = f"Aether storage pool status:\n{out}"
    else:
        status = "FAIL"
        msg = f"Failed to check Aether storage pool status: {err or out}"
    results["aether_storage_pools_space"] = {
        "status": status,
        "output": msg
    }
    
    # 8. Storage Mount Options Check
    update_current_check(category, "storage_mount_options")
    volumes = [
        ("default-vm-container", "/var/lib/hci/aether/volumes/default-vm-container"),
        ("default-image-container", "/var/lib/hci/aether/volumes/default-image-container")
    ]
    
    statuses = []
    messages = []
    
    for name, vol_path in volumes:
        role = get_drbd_role(name)
        should_be_mounted = (role == "Primary")
            
        rc_m, out_m, err_m = run_cmd(f"findmnt -o OPTIONS -n {vol_path}")
        if rc_m != 0:
            if not should_be_mounted:
                statuses.append("PASS")
                messages.append(f"{name}: standby / not mounted locally (Secondary).")
            else:
                statuses.append("FAIL")
                messages.append(f"{name}: CRITICAL: Primary volume is NOT mounted locally!")
        else:
            if not should_be_mounted:
                statuses.append("WARN")
                messages.append(f"{name}: WARNING: Secondary volume is mounted locally!")
            else:
                options = [opt.strip() for opt in out_m.split(",")]
                if "ro" in options:
                    statuses.append("FAIL")
                    messages.append(f"{name}: CRITICAL: mounted READ-ONLY! Active options: {out_m}")
                else:
                    statuses.append("PASS")
                    messages.append(f"{name}: mounted read-write (rw). Options: {out_m}")
                
    status = "FAIL" if "FAIL" in statuses else ("WARN" if "WARN" in statuses else "PASS")
    msg = "\n".join(messages)
    
    results["storage_mount_options"] = {
        "status": status,
        "output": msg
    }
    
    # 9. Storage Volume Writable Check
    update_current_check(category, "storage_volume_writable")
    statuses = []
    messages = []
    
    for name, vol_path in volumes:
        test_file = os.path.join(vol_path, ".mimir_rw_check")
        role = get_drbd_role(name)
        should_be_mounted = (role == "Primary")
            
        rc_m, _, _ = run_cmd(f"findmnt {vol_path}")
        if rc_m != 0:
            if not should_be_mounted:
                statuses.append("PASS")
                messages.append(f"{name}: standby / not mounted locally.")
            else:
                statuses.append("FAIL")
                messages.append(f"{name}: CRITICAL: Primary volume is not mounted, cannot write.")
        else:
            try:
                import uuid
                test_content = f"mimir-test-{uuid.uuid4()}"
                with open(test_file, "w") as f:
                    f.write(test_content)
                    f.flush()
                    os.fsync(f.fileno())
                
                with open(test_file, "r") as f:
                    read_back = f.read().strip()
                    
                if read_back != test_content:
                    statuses.append("FAIL")
                    messages.append(f"{name}: CRITICAL: read back content mismatch!")
                else:
                    statuses.append("PASS")
                    messages.append(f"{name}: Successfully verified read-write operations.")
                
                os.remove(test_file)
            except Exception as e:
                statuses.append("FAIL")
                messages.append(f"{name}: Failed to perform write-read check: {str(e)}")
                if os.path.exists(test_file):
                    try:
                        os.remove(test_file)
                    except Exception:
                        pass
                        
    status = "FAIL" if "FAIL" in statuses else "PASS"
    msg = "\n".join(messages)
    
    results["storage_volume_writable"] = {
        "status": status,
        "output": msg
    }
    
    # 10. /etc/fstab safety check
    update_current_check(category, "fstab_safety_check")
    status = "PASS"
    msg = "No storage mount entries found in /etc/fstab."
    
    try:
        with open("/etc/fstab", "r") as f:
            lines = f.readlines()
            
        brick_entries = []
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) >= 4 and "/var/lib/hci/aether/bricks/" in parts[1]:
                brick_entries.append((parts[0], parts[1], parts[3]))
                
        if brick_entries:
            failed_safety = []
            for spec, mnt, opts in brick_entries:
                opt_list = opts.split(",")
                has_uuid = spec.startswith("UUID=")
                has_nofail = "nofail" in opt_list
                has_timeout = "x-systemd.device-timeout=5s" in opt_list or any("x-systemd.device-timeout" in o for o in opt_list)
                
                issues = []
                if not has_uuid:
                    issues.append("uses raw device path instead of UUID")
                if not has_nofail:
                    issues.append("missing 'nofail' flag")
                if not has_timeout:
                    issues.append("missing 'x-systemd.device-timeout=5s' flag")
                    
                if issues:
                    failed_safety.append(f"Mount {mnt} ({spec}): " + ", ".join(issues))
                    
            if failed_safety:
                status = "FAIL"
                msg = "The following fstab storage mounts do not meet safety requirements:\n" + "\n".join(failed_safety)
            else:
                status = "PASS"
                msg = f"All {len(brick_entries)} fstab storage mount(s) use UUIDs and contain safe timeout/recovery flags."
    except Exception as e:
        status = "FAIL"
        msg = f"Failed to read or parse /etc/fstab: {str(e)}"
        
    results["fstab_safety_check"] = {
        "status": status,
        "output": msg
    }
        
    # 11. Orphaned Disks check
    update_current_check(category, "orphaned_disks_check")
    try:
        import glob
        local_ip = "127.0.0.1"
        try:
            with open("/etc/hci/spectrum/spectrum.env", "r") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        if k == "LOCAL_HYPERVISOR_IP":
                            local_ip = v.strip()
        except Exception:
            pass
            
        if local_ip == "127.0.0.1":
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.connect(("8.8.8.8", 80))
                local_ip = s.getsockname()[0]
                s.close()
            except Exception:
                pass
        
        cql = "SELECT JSON name, disks_list FROM hydra.vms;"
        rc, out, err = run_cmd(f"podman exec -i systemd-hydra-db cqlsh {local_ip} -e \"{cql}\"")
        registered_disk_paths = set()
        if rc == 0:
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("{") and line.endswith("}"):
                    try:
                        vm = json.loads(line)
                        vm_name = vm.get("name")
                        disks_str = vm.get("disks_list", "")
                        if vm_name:
                            if not disks_str or disks_str == "NONE":
                                primary_path = f"/var/lib/hci/aether/volumes/default-vm-container/{vm_name}.raw"
                                registered_disk_paths.add(primary_path)
                            else:
                                for idx, entry in enumerate(disks_str.split(",")):
                                    parts = entry.split(":")
                                    container = parts[1] if len(parts) > 1 else "default-vm-container"
                                    if idx == 0:
                                        d_path = f"/var/lib/hci/aether/volumes/{container}/{vm_name}.raw"
                                    else:
                                        d_path = f"/var/lib/hci/aether/volumes/{container}/{vm_name}_disk{idx}.raw"
                                    registered_disk_paths.add(d_path)
                    except Exception:
                        pass
        
        disk_files = glob.glob("/var/lib/hci/aether/volumes/*/*.raw")
        orphaned_disks = []
        for disk_path in disk_files:
            normalized = disk_path.replace("\\", "/").strip()
            if "default-image-container" in normalized:
                continue
            if normalized not in registered_disk_paths:
                orphaned_disks.append(disk_path)
                
        if orphaned_disks:
            results["orphaned_disks_check"] = {
                "status": "WARN",
                "output": f"Found orphaned virtual disk files without corresponding VMs: {', '.join(orphaned_disks)}.\nThese files should be cleaned up."
            }
        else:
            results["orphaned_disks_check"] = {
                "status": "PASS",
                "output": "No orphaned virtual disk files found. All virtual disks are associated with active virtual machines."
            }
    except Exception as e:
        results["orphaned_disks_check"] = {
            "status": "FAIL",
            "output": f"Error during orphaned disks check: {str(e)}"
        }

    # 12. Broken Disks check
    update_current_check(category, "broken_disks_check")
    try:
        broken_replicas = []
        controller_ips = "127.0.0.1"
        try:
            if os.path.exists("/etc/hci/cluster.json"):
                with open("/etc/hci/cluster.json", "r") as f:
                    cdata = json.load(f)
                    hosts = cdata.get("hosts", [])
                    if hosts:
                        controller_ips = ",".join([h["ip"] for h in hosts])
        except Exception:
            pass

        # 1. Query Linstor volume list
        rc_v, out_v, err_v = run_cmd(f"podman exec -e LS_CONTROLLERS={controller_ips} systemd-aether linstor --no-color volume list")
        if rc_v == 0:
            import re
            ansi_escape = re.compile(r'\\x1B(?:[@-Z\\-_]|\\[[0-?]*[ -/]*[@-~])')
            for line in out_v.splitlines():
                line = line.strip()
                if line.startswith("|") and not ("Resource" in line or "=====" in line or "MinorNr" in line):
                    parts = [p.strip() for p in line.split("|")]
                    if len(parts) >= 11:
                        resource = ansi_escape.sub('', parts[1]).strip()
                        node = ansi_escape.sub('', parts[2]).strip()
                        pool = ansi_escape.sub('', parts[3]).strip()
                        state = ansi_escape.sub('', parts[9]).strip()
                        
                        # Apply healthy rules
                        is_diskless_pool = "diskless" in pool.lower()
                        if is_diskless_pool:
                            is_healthy = state in ["Diskless", "TieBreaker"]
                        else:
                            is_healthy = state == "UpToDate"
                        
                        if not is_healthy:
                            broken_replicas.append(f"Replica of resource '{resource}' on node '{node}' (pool '{pool}') is in state '{state}'")
        else:
            broken_replicas.append(f"Failed to query Linstor volume list: {err_v or out_v}")

        # 2. Check for lingering temporary uploads in local cache
        lingering_files = []
        import time
        now = time.time()
        temp_dirs = [
            "/var/lib/hci/aether/volumes/default-image-container/.tmp_uploads",
            "/var/lib/hci/aether/volumes/default-vm-container/.tmp_uploads"
        ]
        for tdir in temp_dirs:
            if os.path.exists(tdir):
                try:
                    for entry in os.scandir(tdir):
                        if entry.is_file():
                            mtime = entry.stat().st_mtime
                            age_seconds = now - mtime
                            if age_seconds > 7200: # 2 hours
                                size_mb = entry.stat().st_size / (1024 * 1024)
                                lingering_files.append(f"{entry.name} in {os.path.basename(tdir)} (size: {size_mb:.2f} MB, age: {age_seconds/3600:.1f} hours)")
                except Exception as ex:
                    pass

        # Determine health status based on findings
        if broken_replicas:
            results["broken_disks_check"] = {
                "status": "FAIL",
                "output": "CRITICAL: Broken or degraded disk replicas detected in Linstor:\n- " + "\n- ".join(broken_replicas)
            }
        elif lingering_files:
            results["broken_disks_check"] = {
                "status": "WARN",
                "output": "WARNING: Stale temporary upload files found in local cache (.tmp_uploads):\n- " + "\n- ".join(lingering_files) + "\nThese files are taking up local storage space and can be cleaned up."
            }
        else:
            results["broken_disks_check"] = {
                "status": "PASS",
                "output": "All Linstor disk replicas are healthy, and no stale temporary uploads were found in local cache."
            }
    except Exception as e:
        results["broken_disks_check"] = {
            "status": "FAIL",
            "output": f"Error during broken disks check: {str(e)}"
        }

    # 13. DRBD Split-Brain / Diverged Replication Check
    #
    # A StandAlone connection means the two sides stopped replicating and each may have
    # accepted writes the other has not seen. Resolving that is a per-resource question
    # about which copy is authoritative, and it must be answered by an operator or by
    # evidence from the resource itself -- never by a cluster-wide role such as the
    # ZooKeeper leader, which says nothing about who holds the live data.
    update_current_check(category, "drbd_split_brain_check")
    try:
        rc_d, out_d, err_d = run_cmd("drbdsetup status --json")
        source = "host"
        if rc_d != 0 or not out_d.strip():
            rc_d, out_d, err_d = run_cmd(
                "podman exec systemd-aether drbdsetup status --json")
            source = "systemd-aether container"

        # States that mean the two sides are not replicating and may have diverged.
        DIVERGED = ("StandAlone",)
        DEGRADED_CONN = ("Connecting", "Unconnected", "Disconnecting", "NetworkFailure",
                         "ProtocolError", "BrokenPipe", "Timeout", "TearDown")
        BAD_DISK = ("Failed", "Diskless", "DUnknown", "Inconsistent", "Outdated",
                    "Attaching", "Detaching", "Negotiating")

        if rc_d != 0 or not out_d.strip():
            status = "WARN"
            msg = ("DRBD replication state could not be read: drbdsetup is unavailable both on the "
                   f"host and inside systemd-aether ({(err_d or out_d or 'no output').strip()[:300]}). "
                   "Split-brain cannot be ruled out from here.")
        else:
            parsed = None
            try:
                parsed = json.loads(out_d)
            except Exception:
                parsed = None

            if parsed is None:
                # Text fallback: the JSON view is unavailable, but a StandAlone resource is
                # still visible in the plain status output and must not go unreported.
                rc_t, out_t, err_t = run_cmd("drbdadm status")
                if rc_t != 0 or not out_t.strip():
                    rc_t, out_t, err_t = run_cmd("podman exec systemd-aether drbdadm status")
                if rc_t == 0 and "StandAlone" in out_t:
                    status = "FAIL"
                    msg = ("DRBD reports a StandAlone resource (split-brain or a severed "
                           "replication link). Machine-readable status was unavailable, so the "
                           "raw output is reproduced below:\n" + out_t)
                elif rc_t == 0:
                    status = "WARN"
                    msg = ("DRBD JSON status could not be parsed, so only a text scan was possible. "
                           "No StandAlone resource appeared in it:\n" + out_t)
                else:
                    status = "WARN"
                    msg = ("DRBD status is unreadable in both JSON and text form: "
                           f"{(err_t or out_t or 'no output').strip()[:300]}")
            else:
                split_brain, degraded, disk_issues, healthy = [], [], [], []

                for resource in parsed:
                    rname = resource.get("name", "unknown")
                    role = resource.get("role", "Unknown")

                    for dev in resource.get("devices", []):
                        dstate = dev.get("disk-state", "Unknown")
                        if dstate in BAD_DISK:
                            disk_issues.append(
                                f"resource '{rname}' volume {dev.get('volume', 0)} has local "
                                f"disk-state {dstate} (local role {role})")

                    connections = resource.get("connections", [])
                    for conn in connections:
                        peer = conn.get("name") or f"peer-node-id {conn.get('peer-node-id', '?')}"
                        cstate = conn.get("connection") or conn.get("connection-state") or "Unknown"
                        peer_role = conn.get("peer-role", "Unknown")

                        if cstate in DIVERGED:
                            if role == "Primary" and peer_role == "Primary":
                                split_brain.append(
                                    f"resource '{rname}' is StandAlone with BOTH sides Primary "
                                    f"(local and peer '{peer}'): each side has been accepting writes "
                                    f"the other has not seen. Do not let anything auto-discard here; "
                                    f"the surviving copy must be chosen from the data, not from a "
                                    f"cluster-wide role")
                            else:
                                split_brain.append(
                                    f"resource '{rname}' connection to peer '{peer}' is StandAlone "
                                    f"(local role {role}, peer role {peer_role}): replication has "
                                    f"stopped and the copies may have diverged")
                        elif cstate in DEGRADED_CONN:
                            degraded.append(
                                f"resource '{rname}' connection to peer '{peer}' is {cstate} "
                                f"(local role {role}, peer role {peer_role})")

                        for pdev in conn.get("peer_devices", []):
                            vol = pdev.get("volume", 0)
                            repl = pdev.get("replication-state", "Unknown")
                            pdisk = pdev.get("peer-disk-state", "Unknown")
                            if repl in ("SyncTarget", "SyncSource"):
                                # A resync in progress is expected work, not divergence.
                                degraded.append(
                                    f"resource '{rname}' volume {vol} is resyncing with peer "
                                    f"'{peer}' ({repl}, {pdev.get('out-of-sync', 0)} KiB out of sync)")
                            elif repl == "Off" and cstate not in DIVERGED:
                                degraded.append(
                                    f"resource '{rname}' volume {vol} has replication Off toward "
                                    f"peer '{peer}' while the connection reports {cstate}")
                            elif pdisk in BAD_DISK and repl not in ("SyncTarget", "SyncSource"):
                                disk_issues.append(
                                    f"resource '{rname}' volume {vol} reports peer '{peer}' "
                                    f"disk-state {pdisk} (replication {repl})")

                    if not connections:
                        # A resource with no peers is normal on a single-node cluster and for
                        # single-replica placements, so it is reported, not flagged.
                        healthy.append(
                            f"'{rname}' (role {role}) has no replication peers on this node")
                    else:
                        healthy.append(
                            f"'{rname}' (role {role}) with {len(connections)} peer connection(s)")

                if not parsed:
                    status = "PASS"
                    msg = ("No DRBD resources are configured on this node, so there is no "
                           "replication state that could be split-brain.")
                elif split_brain:
                    status = "FAIL"
                    msg = ("DRBD SPLIT-BRAIN / diverged replication detected:\n- "
                           + "\n- ".join(split_brain))
                    if degraded or disk_issues:
                        msg += "\nAlso noted:\n- " + "\n- ".join(degraded + disk_issues)
                elif disk_issues:
                    status = "WARN"
                    msg = "DRBD replica disk states need attention:\n- " + "\n- ".join(disk_issues)
                    if degraded:
                        msg += "\nAlso noted:\n- " + "\n- ".join(degraded)
                elif degraded:
                    status = "WARN"
                    msg = ("DRBD replication is not fully established:\n- " + "\n- ".join(degraded))
                else:
                    status = "PASS"
                    msg = (f"All {len(parsed)} DRBD resource(s) are replicating normally with no "
                           f"StandAlone or diverged connection (read from {source}):\n- "
                           + "\n- ".join(healthy))
    except Exception as e:
        status = "WARN"
        msg = f"Error running DRBD split-brain check: {str(e)}"
    results["drbd_split_brain_check"] = {
        "status": status,
        "output": msg
    }

    return results

def check_hardware(category):
    results = {}
    
    # 1. Host CPU Load Check
    update_current_check(category, "cpu_load")
    try:
        nproc = os.cpu_count() or 1
        with open("/proc/loadavg", "r") as f:
            load = float(f.readline().split()[0])
        pct = (load / nproc) * 100
        status = "PASS"
        if pct > 95:
            status = "FAIL"
        elif pct > 85:
            status = "WARN"
        msg = f"CPU cores: {nproc}\n1-minute load average: {load:.2f} ({pct:.1f}% load average factor)"
    except Exception as e:
        status = "FAIL"
        msg = f"Failed to parse host CPU loadavg: {str(e)}"
    results["cpu_load"] = {
        "status": status,
        "output": msg
    }
    
    # 2. Host RAM usage check
    update_current_check(category, "ram_usage")
    try:
        mem_total = 0
        mem_avail = 0
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    mem_avail = int(line.split()[1])
        used = mem_total - mem_avail
        pct = (used / mem_total) * 100 if mem_total > 0 else 0
        
        status = "PASS"
        if pct > 95:
            status = "FAIL"
        elif pct > 85:
            status = "WARN"
            
        msg = f"Total RAM: {mem_total / 1024:.1f} MB\nUsed RAM: {used / 1024:.1f} MB ({pct:.1f}% used)\nAvailable RAM: {mem_avail / 1024:.1f} MB"
    except Exception as e:
        status = "FAIL"
        msg = f"Failed to check host memory: {str(e)}"
    results["ram_usage"] = {
        "status": status,
        "output": msg
    }
    
    # 3. Host root disk partition check
    update_current_check(category, "disk_space")
    rc, out, err = run_cmd("df -h /")
    if rc == 0:
        lines = out.splitlines()
        pct_val = 0
        if len(lines) >= 2:
            parts = lines[1].split()
            if len(parts) >= 5:
                pct_str = parts[4].replace("%", "")
                pct_val = int(pct_str)
        status = "PASS"
        if pct_val > 90:
            status = "FAIL"
        elif pct_val > 80:
            status = "WARN"
        msg = f"Root Partition Disk Info:\n{out}"
    else:
        status = "FAIL"
        msg = f"Failed to check root filesystem space: {err or out}"
    results["disk_space"] = {
        "status": status,
        "output": msg
    }
    
    # 4. NTP sync check
    update_current_check(category, "ntp_sync")
    rc_active, out_active, err_active = run_cmd("systemctl is-active chronyd")
    if out_active != "active":
        status = "FAIL"
        msg = f"chronyd time synchronization service is not active (status: {out_active})."
    else:
        rc, out, err = run_cmd("chronyc tracking")
        if rc != 0:
            status = "FAIL"
            msg = f"Failed to execute chronyc tracking: {err or out}"
        else:
            ref_id = ""
            offset = 0.0
            for line in out.splitlines():
                if "reference id" in line.lower():
                    ref_id = line.split(":")[-1].strip()
                elif "system time" in line.lower():
                    try:
                        parts = line.split(":")[-1].strip().split()
                        val = float(parts[0])
                        offset = abs(val)
                    except Exception:
                        pass
            
            if not ref_id or ref_id.startswith("0.0.0.0") or "unsynchronised" in ref_id.lower():
                status = "FAIL"
                msg = f"chronyd is active but time is UNSYNCHRONIZED (Reference ID: {ref_id or 'none'}).\n{out}"
            elif offset > 5.0:
                status = "FAIL"
                msg = f"chronyd is synchronized, but clock offset is critically high ({offset:.6f} seconds)!\n{out}"
            elif offset > 1.0:
                status = "WARN"
                msg = f"chronyd is synchronized, but clock offset is high ({offset:.6f} seconds).\n{out}"
            else:
                status = "PASS"
                msg = f"Time is synchronized with NTP. Clock offset is {offset:.6f} seconds.\n{out}"
                
    results["ntp_sync"] = {
        "status": status,
        "output": msg
    }
    
    # 5. Host Virtualization Capabilities Check
    update_current_check(category, "host_virtualization")
    rc_kvm, out_kvm, err_kvm = run_cmd("test -c /dev/kvm")
    if rc_kvm == 0:
        status = "PASS"
        msg = "KVM hardware virtualization is enabled (/dev/kvm exists). QEMU can run VMs with full hardware acceleration."
    else:
        rc_cpu, out_cpu, _ = run_cmd("egrep -c '(vmx|svm)' /proc/cpuinfo")
        cpu_support = False
        try:
            if rc_cpu == 0 and int(out_cpu.strip()) > 0:
                cpu_support = True
        except Exception:
            pass
        if cpu_support:
            status = "WARN"
            msg = "KVM virtualization is disabled (/dev/kvm not found), but CPU supports VT-x/AMD-V. Enable virtualization in BIOS or load kvm kernel modules."
        else:
            status = "WARN"
            msg = "Host lacks full virtualization capabilities. CPU does not support VT-x/AMD-V, and /dev/kvm is missing. QEMU must use slow software emulation (TCG)."
    results["host_virtualization"] = {
        "status": status,
        "output": msg
    }
    
    # 6. Firmware Upgrades Check
    update_current_check(category, "firmware_upgrades")
    rc_fw, out_fw, err_fw = run_cmd("fwupdmgr get-upgrades")
    status = "PASS"
    msg = "No firmware upgrades available."
    if rc_fw == 2:
        status = "WARN"
        msg = f"Firmware upgrades are available!\nSystem Output:\n{out_fw or err_fw}"
    elif rc_fw == 0 and "upgrade" in out_fw.lower() and "no upgrades" not in out_fw.lower():
        status = "WARN"
        msg = f"Firmware upgrades are available!\nSystem Output:\n{out_fw or err_fw}"
    elif rc_fw != 0:
        if "daemon" in err_fw.lower() or "daemon" in out_fw.lower() or "connect" in err_fw.lower():
            status = "PASS"
            msg = f"fwupd daemon is not running or not supported on this host environment.\n{out_fw or err_fw}"
        else:
            status = "WARN"
            msg = f"fwupdmgr get-upgrades returned warning or failed (exit code {rc_fw}):\n{err_fw or out_fw}"
    results["firmware_upgrades"] = {
        "status": status,
        "output": msg
    }
    
    # 7. DNS/NTP synchronization check
    update_current_check(category, "dns_ntp_sync_check")
    try:
        import socket
        local_ip = "127.0.0.1"
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            local_ip = s.getsockname()[0]
            s.close()
        except Exception:
            pass
            
        cql_dns_ntp = "SELECT key, value FROM hydra.cluster_settings;"
        rc_dns_ntp, out_dns_ntp, err_dns_ntp = run_cmd(f"podman exec -i systemd-hydra-db cqlsh {local_ip} -e \"{cql_dns_ntp}\"")
        
        db_dns = []
        db_ntp = []
        
        if rc_dns_ntp == 0:
            for line in out_dns_ntp.splitlines():
                if "dns_servers" in line:
                    parts = line.split("|")
                    if len(parts) >= 2:
                        db_dns = [d.strip() for d in parts[1].strip().split(",") if d.strip()]
                elif "ntp_servers" in line:
                    parts = line.split("|")
                    if len(parts) >= 2:
                        db_ntp = [n.strip() for n in parts[1].strip().split(",") if n.strip()]
        
        if rc_dns_ntp != 0 or not db_dns:
            status = "WARN"
            msg = f"Could not fetch DNS/NTP settings from ScyllaDB (table might not be initialized yet): {err_dns_ntp or out_dns_ntp}"
        else:
            local_dns = []
            if os.path.exists("/etc/resolv.conf"):
                with open("/etc/resolv.conf", "r") as f:
                    for line in f:
                        if line.strip().startswith("nameserver"):
                            parts = line.split()
                            if len(parts) >= 2:
                                local_dns.append(parts[1].strip())
                                
            local_ntp = []
            if os.path.exists("/etc/chrony.conf"):
                with open("/etc/chrony.conf", "r") as f:
                    for line in f:
                        if line.strip().startswith("server") or line.strip().startswith("pool"):
                            parts = line.split()
                            if len(parts) >= 2:
                                local_ntp.append(parts[1].strip())
                                
            dns_issues = [d for d in db_dns if d not in local_dns]
            ntp_issues = [n for n in db_ntp if n not in local_ntp]
            
            issues = []
            if dns_issues:
                issues.append(f"missing DNS server(s) in /etc/resolv.conf: {', '.join(dns_issues)}")
            if ntp_issues:
                issues.append(f"missing NTP server(s) in /etc/chrony.conf: {', '.join(ntp_issues)}")
                
            if issues:
                status = "WARN"
                msg = f"DNS/NTP synchronization mismatch: " + " & ".join(issues) + f"\nDB Config: DNS={db_dns}, NTP={db_ntp}\nLocal Config: DNS={local_dns}, NTP={local_ntp}"
            else:
                status = "PASS"
                msg = f"DNS and NTP configurations are successfully synchronized with the cluster settings database.\nLocal Config: DNS={local_dns}, NTP={local_ntp}"
    except Exception as e:
        status = "WARN"
        msg = f"Error running DNS/NTP synchronization check: {str(e)}"
        
    results["dns_ntp_sync_check"] = {
        "status": status,
        "output": msg
    }
    
    return results

def main():
    category = "all"
    if len(sys.argv) > 2 and sys.argv[1] == "--category":
        category = sys.argv[2]
        
    # Clear any old progress file
    try:
        if os.path.exists(f"/tmp/mimir_check_{category}"):
            os.remove(f"/tmp/mimir_check_{category}")
    except Exception:
        pass

    results = {}
    if category == "services" or category == "all":
        results.update(check_services(category))
    if category == "storage" or category == "all":
        results.update(check_storage(category))
    if category == "hardware" or category == "all":
        results.update(check_hardware(category))
        
    # Clean up progress file at the end
    try:
        if os.path.exists(f"/tmp/mimir_check_{category}"):
            os.remove(f"/tmp/mimir_check_{category}")
    except Exception:
        pass

    print(json.dumps(results, indent=2))

if __name__ == "__main__":
    main()
