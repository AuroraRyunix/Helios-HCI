                if zk_leader_ip:
                    try:
                        import socket
                        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                        s.settimeout(0.2)
                        s.connect((zk_leader_ip, 8443))
                        s.close()
                        leader_active = True
                    except Exception:
                        leader_active = False
                        
                expected_vip_holder = None
